# Copy to .env and adjust. docker compose reads .env automatically.
# The Python scripts read these from the environment; defaults point at localhost.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ecommerce_data
# Host port for Postgres; if you change it, change it in DATABASE_URL too
POSTGRES_PORT=5432

# Used by data_ingestion.py and newapp.py when run on the host
DATABASE_URL=postgresql+psycopg2://change_me:change_me@localhost:5432/ecommerce_data

# Used by data_ingestion.py and data_processing.py
MONGO_URI=mongodb://localhost:27017

# Used by data_ingestion.py: .csv (dd/mm/yy HH:MM dates) or the UCI .xlsx file
DATASET_PATH=data/online_retail.csv
# Leave empty to load only when sales_data is empty; "replace" empties
# sales_data and unstructured_data and reloads the dataset
INGEST_MODE=

# Used by newapp.py
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=0
